{
  "name": "actions-gh-configure-environment",
  "version": "1.0.0",
  "description": "GitHub Action to configure environment settings from a declarative YAML configuration using the GitHub API",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsup && npm run clean-dist",
    "clean-dist": "find dist -type f ! -name 'index.js' ! -name 'index.d.ts' ! -name 'configure-environment.sh' -delete",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "start": "node dist/index.js",
    "prepare": "npm run build",
    "lockfile:sync": "npx -y npm@10.9.2 install --package-lock-only"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "@octokit/rest": "20.1.2",
    "js-yaml": "^5.2.2"
  },
  "devDependencies": {
    "@types/istanbul-lib-coverage": "^2.0.6",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.1.1",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "@vitest/coverage-v8": "^3.2.6",
    "eslint": "^8.57.1",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@10.9.2",
  "overrides": {
    "esbuild": "0.28.1"
  },
  "keywords": [
    "github",
    "environments",
    "configuration",
    "automation",
    "actions"
  ],
  "author": "John Ajera",
  "license": "MIT"
}
